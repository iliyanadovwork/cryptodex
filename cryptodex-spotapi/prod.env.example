# Example for prod.env. Copy to prod.env and fill in.
#
# The real file is gitignored. Credential values are blanked - including in
# commented-out lines, which is where two live-looking keys were hiding.
# Ports, loopback addresses and plain flags are kept as working defaults.

PORT=2053

############### GRPC #################
GRPC_URL=127.0.0.1:5002
GRPC_USER_URL=127.0.0.1:5000
GRPC_WALLET_URL=127.0.0.1:5001

REDIS_PREFIX=
REDIS_URL=
DATABASE_URI=
FRONT_URL=
BASE_URL=
WALLET_URL=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
#BINANCE_API_KEY=
#BINANCE_SECRET_KEY=

# AES key for order-payload encryption (see cryptoJS.js)
CRYPTO_SECRET_KEY=
