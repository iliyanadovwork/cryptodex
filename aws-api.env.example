# =============================================================================
# CRYPTODEX API SERVICE - Railway environment variables.  TEMPLATE. NO SECRETS.
# =============================================================================
#
# This is the variable set for the ONE Railway service that runs userapi,
# walletapi, spotapi and the gateway in a single container (deploy/supervisor.mjs
# + deploy/gateway.mjs).  Paste it into Railway's "Raw Editor" on that service's
# Variables tab, then fill in every <ANGLE BRACKET>.
#
# The frontend does NOT use this file.  See vercel-frontend.env.example.
#
# HOW TO READ IT
#   REQUIRED   the venue does not work without it
#   ADVISED    works without it, but something visible is wrong
#   OPTIONAL   a tuning knob with a sane default
#   DEAD       read by config/index.js, consumed by nothing.  Do not set it.
#
# THE ONE THING THAT IS EASY TO GET WRONG.  All three backends share this single
# process environment, because they share one container.  Three variables must
# therefore be DIFFERENT per backend and cannot come from here as plain names:
# PORT, DATABASE_URI and GRPC_URL.  deploy/supervisor.mjs already injects PORT
# per child.  It must also inject DATABASE_URI and GRPC_URL - see the note under
# "Per-service overrides" below and section 6 of DEPLOYMENT.md.
# =============================================================================


# --- 1. RUNTIME --------------------------------------------------------------

# REQUIRED.  Selects the production branch of every config/index.js, and - this
# is the part that matters - lib/mailDelivery.js treats "production" as a hard
# veto that forces real e-mail delivery.  Anything else and activation mail is
# written to the log instead of sent.
NODE_ENV=production

# REQUIRED, injected by Railway.  The gateway binds it.  Do NOT set it yourself;
# if you do, the gateway and Railway's router disagree and every request 502s.
# PORT=<injected by Railway>

# OPTIONAL.  Loopback ports inside the container.  The defaults match the
# developer machine and deploy/routes.mjs.  Change all four places or none.
# USERAPI_PORT=2567
# SPOTAPI_PORT=2568
# WALLETAPI_PORT=3002


# --- 2. DATABASES ------------------------------------------------------------
#
# THREE separate Mongo databases on ONE cluster.  The seed script creates
# <prefix>_user, <prefix>_wallet and <prefix>_spot; keep the prefix "cryptodex"
# unless you also pass --db-prefix to ops/reset-and-seed.mjs.
#
# Shape (MongoDB Atlas):
#   mongodb+srv://<user>:<urlencoded-password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&maxPoolSize=10
#
# maxPoolSize=10 is not decoration.  Mongoose 6 defaults to 100 sockets per
# connection and this container opens four of them (userapi, walletapi, spotapi,
# and spotapi's second connection for WALLET_DB_URL).  Unbounded that is 400
# sockets against an Atlas M0 whose ceiling is 500.

# REQUIRED - per-service, see the header note.
USERAPI_DATABASE_URI=<atlas srv uri ending /cryptodex_user?retryWrites=true&w=majority&maxPoolSize=10>
WALLETAPI_DATABASE_URI=<same cluster, /cryptodex_wallet, same query string>
SPOTAPI_DATABASE_URI=<same cluster, /cryptodex_spot, same query string>

# REQUIRED, spotapi only, and the single easiest variable to miss.
# spotapi/models/currency.js opens a SECOND mongoose connection to the WALLET
# database to read the `currency` collection, and it is the only variable in the
# whole stack that appears in no local.env, no dev.env and no prod.env.  Its
# hard-coded fallback is mongodb://localhost:27017/cryptodex_wallet, which on
# Railway resolves to nothing: currency lookups fail and the pair list is
# incomplete, with no error that names this variable.
WALLET_DB_URL=<same value as WALLETAPI_DATABASE_URI>

# REQUIRED.  One Redis, shared by all three backends.
#   Railway Redis (recommended): redis://default:<password>@<host>.railway.internal:6379
#   Any TLS provider:            rediss://default:<password>@<host>:<port>
# node-redis 3.1.2 understands rediss:// (it sets a TLS socket) and understands
# user:password ACL auth.  Verified by reading the driver, not by connecting.
REDIS_URL=<redis or rediss url>

# REQUIRED.  Every Redis key the venue writes is prefixed with this.  It must be
# byte-identical to the --redis-prefix you seed with, trailing underscore
# included.  A mismatch is silent: the services write to one keyspace and the
# ladder, the pair cache and the liquidity bot sit in another.
REDIS_PREFIX=cryptodex_


# --- 3. IDENTITY AND CRYPTO --------------------------------------------------

# REQUIRED, and SERVER-ONLY.  It signs and verifies the session JWT.  Any long
# random string; generate one with `openssl rand -hex 48`.
#
# It must NOT be given to the frontend.  An earlier draft of these files told you
# to copy it into NEXT_PUBLIC_SECRET_KEY, which would have published it to every
# visitor in the browser bundle.  That variable has been removed; the frontend
# never read it.
#
# READ THIS BEFORE YOU DEBUG A LOGIN PROBLEM.  Every config/index.js falls back
# to a hard-coded key when SECRET_KEY is unset.  All three fall back to the SAME
# hard-coded key, so leaving it unset everywhere "works" - and setting it on some
# services and not others is the failure mode: userapi issues a token nothing
# else will accept.  Set it, or do not; never half.
SECRET_KEY=<a long random string, identical here and in the frontend>

# NOT AN ENVIRONMENT VARIABLE ON THE BACKEND.  cryptoSecretKey is a constant in
# each config/index.js and cannot be overridden from the environment.  The
# frontend's NEXT_PUBLIC_CRYPTO_SECRET_KEY must equal it exactly or every order
# is rejected with {"errors":{"token":"INVALID"}}.  Copy the value out of
# cryptodex-frontend/.env.local.example, which already
# carries the correct constant.  Do not invent one.


# --- 4. PUBLIC URLS ----------------------------------------------------------

# REQUIRED.  The public origin of THIS Railway service - the gateway hostname.
# Both userapi and walletapi read it (as SERVER_URL and IMAGE_URL) to build
# absolute URLs for static assets; the gateway routes /images, /profile,
# /currency and /deposit to the right upstream, so one value serves both.
# No trailing slash.
BASE_URL=https://<your-api-service>.up.railway.app

# REQUIRED.  The public origin of the FRONTEND.  This is what activation and
# password-reset links in outgoing e-mail are built from
# (userapi/controllers/auth.controller.js).  Point it at the wrong host and
# registration completes but nobody can ever click through.  No trailing slash.
FRONT_URL=https://<your-frontend>.vercel.app

# ADVISED.  Appears in e-mail templates as the application name.
SITE_NAME=Cryptodex Exchange

# DEAD.  There is no admin panel.  config/index.js still reads ADMIN_URL and
# nothing renders from it.  Leave it unset.
# ADMIN_URL=

# ADVISED, spotapi only.  Legacy alias for the wallet service's HTTP base.  On
# the single-container topology it is the same origin as BASE_URL.
WALLET_URL=https://<your-api-service>.up.railway.app


# --- 5. GRPC (inside the container, loopback) --------------------------------
#
# These stay on 127.0.0.1 exactly as on the developer machine, which is the whole
# reason for the one-container topology: the gRPC channels are plaintext
# (createInsecure on both ends) and must never cross a network.
#
# GRPC_URL is the BIND address and differs per backend, so like DATABASE_URI it
# cannot be a single shared name - see the header note.  The three dial addresses
# below are per-target and are correctly shared.

USERAPI_GRPC_URL=127.0.0.1:6001
WALLETAPI_GRPC_URL=127.0.0.1:6002
SPOTAPI_GRPC_URL=127.0.0.1:6003

GRPC_USER_URL=127.0.0.1:6001
GRPC_WALLET_URL=127.0.0.1:6002
GRPC_SPOT_URL=127.0.0.1:6003

# DEAD - the P2P product was removed.  Read by spotapi and walletapi configs,
# dialled by nothing.
# GRPC_P2P_URL=


# --- 6. E-MAIL (Resend) ------------------------------------------------------
#
# Under NODE_ENV=production mail delivery is FORCED ON and no flag can turn it
# off (lib/mailDelivery.js checks production first).  Without a key, userapi
# logs "[mail] RESEND_API_KEY is not configured - refusing to attempt delivery"
# and registration completes with no activation e-mail and no user-visible error.

# REQUIRED for anyone to be able to register.
# Shape: re_ followed by ~30 url-safe characters.  Get it at
# https://resend.com -> API Keys -> Create.  Free tier: 3,000 mails/month.
RESEND_API_KEY=<re_...>

# REQUIRED.  Must be on a domain you have verified in Resend, or Resend rejects
# the send.  Until a domain is verified, Resend's shared sender
# onboarding@resend.dev works but can only deliver to your own account address -
# fine for a first smoke test, useless for real users.
RESEND_FROM_EMAIL=noreply@<your-verified-domain>


# --- 7. THINGS THAT MUST NOT BE SET IN PRODUCTION ----------------------------
#
# TEST_MODE=true does two things beyond its name, both of them auth bypasses:
#   1. userapi/controllers/auth.controller.js:933 skips OTP validation entirely;
#   2. it enables POST /api/auth/test-verify, which marks ANY e-mail address
#      "verified" on request, with no proof of ownership (auth.controller.js:1704).
# Leave it unset.  It is listed here only so nobody copies it across from
# local.env, where it is correctly set to true.
# TEST_MODE=

# Same class.  DEV_RECAPTCHA_BYPASS and DEV_EMAIL_BYPASS are local-development
# opt-ins.  Neither has any effect under NODE_ENV=production, but do not set them.
# DEV_RECAPTCHA_BYPASS=
# DEV_EMAIL_BYPASS=


# --- 8. TUNING KNOBS (all optional, all have defaults) -----------------------
#
# Listed because two of them are the cheapest levers on the Railway bill.  See
# DEPLOYMENT.md section 3.

# Fill canary - the read-only self-test behind GET /api/spot/health.
# SPOT_CANARY_INTERVAL_MS=180000
# SPOT_CANARY_FIRST_RUN_DELAY_MS=20000
# SPOT_CANARY_NOTIONAL=10
# SPOT_CANARY_REPEAT_LOG_MS=600000
# SPOT_CANARY_HEALTH_CACHE_MS=2000
# SPOT_CANARY_LAST_FILL_CACHE_MS=30000
# SPOT_CANARY_DISABLED=          # "true" switches the canary off. Do not.

# Paper ladder shape and its staleness gates.
# PAPER_BOOK_MIN_NOTIONAL=
# PAPER_BOOK_SIZE_MULT=
# PAPER_BOOK_STALE_MS=
# PAPER_BOOK_LADDER_STALE_MS=
# PAPER_BOOK_ORPHAN_MS=
# PAPER_BOOK_CROSS_GUARD=

# Binance depth watchdog.
# BINANCE_DEPTH_SILENCE_MS=
# BINANCE_DEPTH_WATCHDOG_MS=
# BINANCE_DEPTH_RECONNECT_MS=
# BINANCE_DEPTH_DESYNC_MS=

# Order-book push interval, milliseconds.  Default 1000.  This is a direct
# multiplier on Railway egress: every connected trading screen receives one book
# payload per interval.  Raising it to 2000 halves that bill.
# BOOK_PUBLISH_HEARTBEAT_MS=1000


# --- 9. DEAD VARIABLES - DO NOT CARRY THESE FORWARD -------------------------
#
# Every one of these is read by a config/index.js and consumed by no surviving
# code path.  They are listed so that meeting them in an older checkout does not
# send anyone hunting for a key.  Setting them changes nothing; setting them to a
# real credential puts a live secret in an environment for no benefit.
#
#   BINANCE_API_KEY, BINANCE_SECRET_KEY   the depth feed is the PUBLIC websocket
#   RECAPTCHA_SECRET_KEY                  registration does not enforce reCAPTCHA
#   SUMSUB_TOKEN, SUMSUB_KEY, SUMSUB_WEBHOOK_KEY        KYC removed
#   TELNYX_API_KEY, TELNYX_PHONE_NUMBER, SMS_TYPE       SMS/phone OTP removed
#   FIREBLOCK_BASE_URL, FIREBLOCK_API_KEY,
#     FIREBLOCK_GAS_STATION_ADDRESS, FIREBLOCK_GAS_STATION_ADDRESS_BNB,
#     TRX_WALLET_ID, BNB_WALLET_ID                      custody removed
#   INFURA_API_KEY                        EVM custody removed. NOTE: walletapi's
#                                         config carries a hard-coded fallback
#                                         value for this one; nothing dials it.
#   HELIUS_*, HOT_WALLET_*, NETWORK       Solana custody removed
#   GRPC_P2P_URL                          the P2P product was removed
#   ADMIN_URL                             the admin panel was removed
#   MODE                                  walletapi reads it at one dead branch
#   ENV                                   read by nothing
#   ABCD_API_KEY                          hard-coded inside the chart controller
#                                         before it is read; the environment
#                                         cannot influence it
