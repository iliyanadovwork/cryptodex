GRPC_WALLET_URL=127.0.0.1:4569
GRPC_SPOT_URL=127.0.0.1:4568
GRPC_P2P_URL=127.0.0.1:6004

SITE_NAME=
REDIS_PREFIX=
REDIS_URL=
DATABASE_URI=mongodb://localhost:27017/cryptodex_user
FRONT_URL=
BASE_URL=http://localhost:3001
ADMIN_URL=
RECAPTCHA_SECRET_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_API_KEY=
SMS_TYPE=

SUMSUB_TOKEN=
SUMSUB_KEY=
SUMSUB_WEBHOOK_KEY=

# Resend Email Configuration
RESEND_API_KEY=
