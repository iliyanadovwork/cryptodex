# User API - HTTP 2567, gRPC 6001 - local environment, EXAMPLE.
#
#     cp local.env.example local.env
#
# This is the file the service reads at startup (nodemon ... dotenv_config_path=local.env).
#
# WHAT IS FILLED IN: every port, URL, database name and redis prefix, correct
# for the whole stack running on one machine. Copy this file, set SECRET_KEY,
# and the service starts.
#
# WHAT IS BLANK: every credential. On a paper-trading venue almost none of them
# are needed - no real money moves, no blockchain is touched, and mail is
# written to the log instead of sent.
#
# Lines marked DEAD belong to a product that has been removed from this
# repository. They are listed, blank, so that a reader who meets them in an
# older checkout knows not to go hunting for a key to put in them.

PORT=2567

# MUST be byte-identical in userapi, spotapi and walletapi - it signs the
# session JWT that all three verify, so a mismatch logs you out of one service
# and not the others. Generate a fresh one per environment; do NOT reuse the
# value committed in local.env, which is in the repository history.
#
# It does NOT go in the frontend. The old wording here named the frontend's
# NEXT_PUBLIC__SECRET_KEY as a fourth place to keep in step; NEXT_PUBLIC_* values
# are inlined into the browser bundle, and the frontend never verifies a JWT
# anyway. See the frontend's .env.local.example.
SECRET_KEY=
CRYPTO_SECRET_KEY=

############### GRPC #################
GRPC_URL=127.0.0.1:6001
GRPC_USER_URL=127.0.0.1:6001
GRPC_WALLET_URL=127.0.0.1:6002
GRPC_SPOT_URL=127.0.0.1:6003
# DEAD - the P2P product was removed
GRPC_P2P_URL=

SITE_NAME=Cryptodex Exchange
REDIS_PREFIX=cryptodex_
REDIS_URL=redis://localhost:6379
DATABASE_URI=mongodb://127.0.0.1:27017/cryptodex_user
FRONT_URL=http://localhost:3000
BASE_URL=http://localhost:2567
ADMIN_URL=http://localhost:4001
# leave blank - registration does not enforce reCAPTCHA on this venue.
RECAPTCHA_SECRET_KEY=
# DEAD - SMS/phone OTP removed
TELNYX_PHONE_NUMBER=
# DEAD - SMS/phone OTP removed
TELNYX_API_KEY=
# DEAD - SMS/phone OTP removed
SMS_TYPE=

# DEAD - KYC removed
SUMSUB_TOKEN=
# DEAD - KYC removed
SUMSUB_KEY=
# DEAD - KYC removed
SUMSUB_WEBHOOK_KEY=
# Resend Email Configuration
# leave blank - with TEST_MODE=true mail is written to the service log,
# never sent, and the activation link is in that log.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cryptodex.exchange
TEST_MODE=true

# DEAD - appears only in the committed prod.env, is read by nothing in this
# repository (`grep -r GRPC_CURRENCY_URL` returns no source hit), and is a
# leftover alias for GRPC_USER_URL from a currency service that no longer
# exists. Listed here so a reader who meets it in prod.env does not go looking
# for a service to point it at.
GRPC_CURRENCY_URL=
