# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json is committed on purpose: the deploy image is built off this
# repo on a remote runner and uses `npm ci`. See the root .gitignore.
yarn.lock
pnpm-lock.yaml

# Dependency directories
node_modules/

# Public directories
public/

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# ============================================
# SECURITY - NEVER COMMIT THESE
# ============================================

# Environment variables (may contain secrets)
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Credentials and secrets
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
credentials.json
secrets.json

# Database backups with sensitive data
*.sql
*.sqlite
*.db

# Admin/User setup scripts with credentials
createAdmin.js
update-password.js
update-password2.js

# Private keys and configs
config/private.js
secrets/
.secrets/

# IDE specific files that may contain tokens
.vscode/
.idea/
*.swp
*.swo
*~

# Build output may contain sensitive data
dist/
build/
.next/

