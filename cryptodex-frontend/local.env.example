# Frontend - the file `npm run dev` insists on, and which configures nothing.
#
#     cp local.env.example local.env
#
# `npm run dev` is `env-cmd -f local.env next dev`. env-cmd exits before Next
# starts if this file does not exist, so a fresh clone cannot run the frontend
# without it - and it is not in git.
#
# But every key here is spelled with a DOUBLE underscore (NEXT_PUBLIC__USER_API)
# while `config/index.js` reads SINGLE underscores (NEXT_PUBLIC_USER_API), so
# nothing in this file has ever reached the application. That is not a mistake
# to fix by renaming: the real configuration is `.env.local`, Next loads it
# directly, and `config/index.js` carries correct localhost fallbacks for when
# it is absent. See `.env.local.example`.
#
# The values below are therefore deliberately inert. They are the URLs of the
# real stack so that nobody reading this file is misled about the layout, but
# changing them changes nothing.

NEXT_PUBLIC__API_URL=http://localhost:2567
NEXT_PUBLIC__USER_API=http://localhost:2567
NEXT_PUBLIC__WALLET_API=http://localhost:3002
NEXT_PUBLIC__SPOT_API=http://localhost:2568
NEXT_PUBLIC__SOCKET_URL=http://localhost:2568
NEXT_PUBLIC__FRONT_URL=http://localhost:3000
NEXT_PUBLIC__SITE_NAME=Cryptodex Exchange
NEXT_PUBLIC__MODE=development
NEXT_PUBLIC__GENERATE_SOURCEMAP=false
NEXT_PUBLIC__FAST_REFRESH=true
NEXT_PUBLIC__SKIP_PREFLIGHT_CHECK=true
NEXT_PUBLIC__IMAGE_INLINE_SIZE_LIMIT=0

# Credentials: blank. Set the real ones in .env.local, which is the file that
# is actually read.
NEXT_PUBLIC__SECRET_KEY=
NEXT_PUBLIC__CRYPTO_SECRET_KEY=
NEXT_PUBLIC__RECAPTCHA_KEY=

# The committed dev.env and prod.env also carry these two. Like everything else
# in this file they are double-underscored and reach nothing; NEXT_PUBLIC__
# P2P_API in particular names a product that was removed from the repository.
# They are listed so the variable set here matches those files exactly.
NEXT_PUBLIC__P2P_API=
NEXT_PUBLIC__ONRAMP_APP_ID=
