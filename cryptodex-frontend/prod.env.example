# Example for prod.env. Copy to prod.env and fill in.
#
# The real file is gitignored. Credential values are blanked - including in
# commented-out lines, which is where two live-looking keys were hiding.
# Ports, loopback addresses and plain flags are kept as working defaults.

NEXT_PUBLIC__SECRET_KEY=
NEXT_PUBLIC__CRYPTO_SECRET_KEY=1234567812345678
NEXT_PUBLIC__RECAPTCHA_KEY=
NEXT_PUBLIC__API_URL=
NEXT_PUBLIC__FRONT_URL=
NEXT_PUBLIC__GENERATE_SOURCEMAP=false
NEXT_PUBLIC__IMAGE_INLINE_SIZE_LIMIT=0
NEXT_PUBLIC__FAST_REFRESH=false
NEXT_PUBLIC__SKIP_PREFLIGHT_CHECK=true
NEXT_PUBLIC__USER_API=
NEXT_PUBLIC__WALLET_API=
NEXT_PUBLIC__SPOT_API=
NEXT_PUBLIC__P2P_API=
NEXT_PUBLIC__SITE_NAME=
NEXT_PUBLIC__ONRAMP_APP_ID=731193
NEXT_PUBLIC__MODE=prod
