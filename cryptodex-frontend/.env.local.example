# Frontend (Next.js) - EXAMPLE of the file that actually configures it.
#
#     cp .env.local.example .env.local
#
# READ THIS BEFORE YOU EDIT THE WRONG FILE. The frontend has two environment
# files and only one of them does anything:
#
#   .env.local   SINGLE underscore   NEXT_PUBLIC_USER_API   <- config/index.js
#                                                              reads these
#   local.env    DOUBLE underscore   NEXT_PUBLIC__USER_API  <- read by env-cmd,
#                                                              matches nothing
#
# `npm run dev` is `env-cmd -f local.env next dev`, so local.env must EXIST or
# the command fails before Next starts - but every key in it is spelled with a
# double underscore, and `config/index.js` reads single underscores. Nothing in
# local.env has ever reached the application. The values that matter are these,
# and Next loads .env.local by itself. (config/index.js has a comment saying the
# same thing, at the fallbacks.)
#
# If .env.local is absent the hard-coded fallbacks in config/index.js take over,
# and on a single-machine stack those fallbacks are correct - so the frontend
# will work without this file. Copy it anyway: a fallback that drifts from the
# real port renders the page that reads it blank, with no error to explain it.

# Where the four services listen. Correct for a stack on one machine.
NEXT_PUBLIC_API_URL=http://localhost:2567
NEXT_PUBLIC_USER_API=http://localhost:2567
NEXT_PUBLIC_WALLET_API=http://localhost:3002
NEXT_PUBLIC_SPOT_API=http://localhost:2568
NEXT_PUBLIC_SOCKET_URL=http://localhost:2568
NEXT_PUBLIC_FRONT_URL=http://localhost:3000

NEXT_PUBLIC_MODE=development

# LEAVE BLANK. DO NOT put the backends' SECRET_KEY here.
#
# This line used to read "MUST be byte-identical to SECRET_KEY in userapi,
# spotapi and walletapi". That instruction was wrong and actively dangerous.
# Every NEXT_PUBLIC_* value is INLINED BY NEXT INTO THE CLIENT BUNDLE at build
# time, so following it publishes the key that signs every session JWT to
# anyone who opens devtools - which is enough to mint a token for any account.
#
# It is also unnecessary. `config/index.js` assigns this to `secretOrKey`, and
# `secretOrKey` is referenced nowhere else in the frontend; the only JWT code
# here is `jwt-decode`, which reads a token's payload and verifies nothing. The
# NEXT_PUBLIC_SECRET_KEY IS DELIBERATELY ABSENT. It used to carry the BACKENDS'
# JWT signing key, and anything NEXT_PUBLIC_ is inlined into the browser bundle
# and served to every visitor -- so the key that signs every session was public
# and forgeable. Nothing read it; config/index.js says so at the removal site.
# Do not reintroduce it. The backends' SECRET_KEY must never leave the server.

# Browser-side payload key. It MUST equal the backends' `cryptoSecretKey`
# (spotapi/config/index.js) - the browser AES-encrypts every order body with it
# and spotapi decrypts with that constant, so a mismatched value makes every
# order fail with {"errors":{"token":"INVALID"}}. Set it to the same value as
# the backend's CRYPTO_SECRET_KEY.
#
# NOTE ON WHAT THIS IS WORTH. It is NEXT_PUBLIC_, so the browser receives it in
# the bundle and it cannot be secret from a user. It is obfuscation in transit,
# not protection. It is blank here because a committed template is the wrong
# place for a live value, not because knowing it breaks anything on its own.
NEXT_PUBLIC_CRYPTO_SECRET_KEY=

# Leave blank. The register form does not enforce reCAPTCHA on this venue.
NEXT_PUBLIC_RECAPTCHA_KEY=

# Both are read by config/index.js and were previously undocumented here.
# Leave both blank: the geo lookup endpoint is not called on this venue, and the
# on-ramp (fiat purchase) widget went with the custody features.
NEXT_PUBLIC_GEO_INFO=
NEXT_PUBLIC_ONRAMP_APP_ID=
