# Example for dev.env. Copy to dev.env and fill in.
#
# The real file is gitignored. Credential values are blanked - including in
# commented-out lines, which is where two live-looking keys were hiding.
# Ports, loopback addresses and plain flags are kept as working defaults.

PORT=3002
SECRET_KEY=
CRYPTO_SECRET_KEY=

############### GRPC #################
GRPC_URL=127.0.0.1:4569
GRPC_USER_URL=127.0.0.1:4567
GRPC_WALLET_URL=127.0.0.1:4569
GRPC_SPOT_URL=127.0.0.1:4568
GRPC_P2P_URL=127.0.0.1:6004

SITE_NAME=
REDIS_PREFIX=
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URI=mongodb://localhost:27017/cryptodex_wallet
FRONT_URL=
BASE_URL=http://localhost:3002

FIREBLOCK_BASE_URL=
FIREBLOCK_GAS_STATION_ADDRESS=
FIREBLOCK_API_KEY=

TRX_WALLET_ID=
ENV=
# Spot API Integration
SPOT_API_URL=http://localhost:3003
INTERNAL_API_SECRET=
